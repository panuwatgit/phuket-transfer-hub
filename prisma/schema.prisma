generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── enums ──────────────────────────────────────────────────────────────────

enum VehicleType {
  VAN_VIP8
  VAN_VIP10
  SUV
  SEDAN
}

enum ServiceType {
  AIRPORT
  POINT_TO_POINT
  DAILY_CHARTER
  MULTI_DAY
}

enum RequestStatus {
  NEW
  SOURCING
  QUOTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentTerm {
  FULL_PREPAID
  DEPOSIT_50
  CREDIT
}

enum ContactChannel {
  LINE
  PHONE
  WHATSAPP
  EMAIL
}

enum AirportDirection {
  FROM_AIRPORT
  TO_AIRPORT
}

enum DocumentType {
  QUOTE
  RECEIPT
}

enum ExpenseCategory {
  PARTNER_PAYOUT // จ่ายค่ารถ/คนขับพาร์ทเนอร์
  FUEL
  PARKING
  MEAL // ค่าอาหาร/เบี้ยเลี้ยงคนขับ
  MAINTENANCE
  MARKETING
  FEE // ค่าธรรมเนียม/แพลตฟอร์ม
  OTHER
}

// ── partners & vehicles ────────────────────────────────────────────────────

model Partner {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String
  lineId    String?
  rating    Int       @default(4) // internal 1–5
  note      String?
  active    Boolean   @default(true)
  vehicles  Vehicle[]
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Vehicle {
  id          Int         @id @default(autoincrement())
  partnerId   Int
  partner     Partner     @relation(fields: [partnerId], references: [id])
  type        VehicleType
  plate       String
  model       String?
  seats       Int
  photoUrl    String?
  costAirport Int? // ทุนอ้างอิง รับส่งสนามบิน (บาท)
  costDaily   Int? // ทุนอ้างอิง เหมา 8 ชม. (บาท)
  active      Boolean     @default(true)
  note        String?
  requests    BookingRequest[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type, active])
}

// ── requests ───────────────────────────────────────────────────────────────

model BookingRequest {
  id     Int           @id @default(autoincrement())
  code   String        @unique // PTH-2026-0001
  status RequestStatus @default(NEW)
  lang   String        @default("th") // ภาษาที่ลูกค้าใช้กรอก (th/en) → ตอบภาษานั้น

  // step 1 — vehicle
  vehicleType  VehicleType
  vehicleCount Int         @default(1)

  // step 2 — trip
  serviceType   ServiceType
  direction     AirportDirection?
  pickupDate    DateTime          @db.Date
  pickupTime    String // "HH:mm"
  pickupPlace   String
  dropoffPlace  String?
  dropoffProvince String?
  roundTrip     Boolean           @default(false)
  returnDate    DateTime?         @db.Date
  returnTime    String?
  flightNo      String?
  days          Int? // DAILY_CHARTER / MULTI_DAY
  itinerary     String?
  passengers    Int
  luggage       Int               @default(0)

  // step 3 — contact
  customerName   String
  phone          String
  lineId         String?
  email          String?
  company        String?
  contactChannel ContactChannel @default(LINE)
  customerNote   String?

  // LINE linkage (filled by webhook when customer sends the prefilled message)
  lineUserId   String?
  lineLinkedAt DateTime?

  // admin — sourcing & pricing
  vehicleId    Int?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  costPrice    Int? // ทุนจ่ายพาร์ทเนอร์ (ต่อเที่ยว หรือ ต่อวัน)
  sellPrice    Int? // ราคาขาย (ต่อเที่ยว หรือ ต่อวัน)
  otRate       Int      @default(300)
  otHours      Int      @default(0)
  fuelIncluded Boolean  @default(false)

  // admin — payment
  paymentTerm PaymentTerm @default(FULL_PREPAID)
  amountPaid  Int         @default(0)
  paidAt      DateTime?

  adminNote    String?
  cancelReason String?

  statusLogs  StatusLog[]
  documents   Document[]
  expenses    Expense[]
  attachments Attachment[]
  createdAt   DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([pickupDate])
  @@index([lineUserId])
}

model StatusLog {
  id         Int            @id @default(autoincrement())
  requestId  Int
  request    BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus RequestStatus?
  toStatus   RequestStatus
  note       String?
  actor      String         @default("admin")
  createdAt  DateTime       @default(now())

  @@index([requestId, createdAt])
}

// running number per year: key = "request:2026"
model Counter {
  key   String @id
  value Int    @default(0)
}

// ใบเสนอราคา / ใบเสร็จรับเงิน — snapshot ณ วันออก (แก้ request ทีหลังไม่กระทบเอกสารที่ออกแล้ว)
model Document {
  id        Int            @id @default(autoincrement())
  number    String         @unique // QT-2026-0001 / RC-2026-0001
  type      DocumentType
  token     String         @unique // ลิงก์สาธารณะ /doc/<token>
  lang      String         @default("th")
  requestId Int
  request   BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  customerName    String
  customerCompany String?
  customerPhone   String
  customerTaxId   String?
  customerAddress String?

  items         Json // [{ desc, qty, unit, unitPrice, amount }]
  total         Int
  amountPaid    Int      @default(0) // ใบเสร็จ: ยอดรับครั้งนี้
  paidBefore    Int      @default(0) // ใบเสร็จ: รับไปแล้วก่อนหน้า
  balance       Int      @default(0)
  paymentMethod String?
  paymentTerm   String? // ใบเสนอราคา: เงื่อนไขชำระ
  validDays     Int? // ใบเสนอราคา: ยืนราคา (วัน)
  showTaxId     Boolean  @default(false)
  note          String?

  issuedAt DateTime  @default(now())
  voidedAt DateTime?

  @@index([requestId, type])
}

// รายจ่าย — ผูกกับงาน (requestId) หรือทั่วไป (null) · เก็บไว้ทำบัญชี/ภาษี
model Expense {
  id        Int             @id @default(autoincrement())
  requestId Int?
  request   BookingRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  partnerId Int?
  partner   Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  category  ExpenseCategory @default(PARTNER_PAYOUT)
  amount    Int
  paidAt    DateTime        @db.Date
  method    String? // TRANSFER / PROMPTPAY / CASH
  payee     String? // ชื่อผู้รับเงิน (ถ้าไม่ใช่พาร์ทเนอร์ในระบบ)
  note      String?
  attachments Attachment[]
  createdAt DateTime        @default(now())

  @@index([paidAt])
  @@index([requestId])
}

// ไฟล์แนบ (สลิปโอน / ใบเสร็จร้านค้า) — เก็บใน DB เพื่อไม่หายตอน deploy ใหม่ (จำกัด ~4MB/ไฟล์)
model Attachment {
  id        Int             @id @default(autoincrement())
  expenseId Int?
  expense   Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  requestId Int? // สลิปลูกค้าโอนเข้า
  request   BookingRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filename  String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime        @default(now())
}
